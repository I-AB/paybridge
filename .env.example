# Copy these into your shell (or IDE run configuration). Do NOT commit real values.
# Use a TEST secret key from the Paystack dashboard (Settings > API Keys & Webhooks, Test mode).
PAYSTACK_SECRET_KEY=your_test_secret_key
# paystack (default) or simulated (offline demo, no Paystack account needed)
PAYBRIDGE_GATEWAY=paystack
# set to false if name enquiry does not work with your test account
PAYBRIDGE_RESOLVE_ACCOUNT=true
